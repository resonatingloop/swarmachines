{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swarmachines/events/v1",
  "title": "swarmachines event record",
  "description": "one record per logged event. (run_id, seq) is unique within a run and seq increases in append order; uniqueness is enforced by the runner, not by json schema. message lifecycle: sent, delivered, seen, acted_on are separate transitions and must never be conflated.",
  "type": "object",
  "required": ["run_id", "seq", "turn", "agent_id", "type", "ts", "payload"],
  "properties": {
    "run_id": { "type": "string", "description": "stable identifier for one episode" },
    "seq": { "type": "integer", "minimum": 0, "description": "append-order index, unique with run_id" },
    "turn": { "type": "integer", "minimum": 0 },
    "agent_id": { "type": ["string", "null"], "description": "null for world-level events" },
    "type": {
      "enum": [
        "run.config", "world.init", "turn.begin",
        "observation.recorded",
        "message.sent", "message.delivered", "message.seen", "message.acted_on",
        "action.proposed", "action.validated", "action.rejected", "action.committed",
        "world.changed", "disturbance.applied",
        "run.end", "policy.decision", "policy.report", "jobs.initialized", "job.completed"
      ]
    },
    "ts": { "type": "string", "format": "date-time", "description": "wall-clock at append time; logical time lives in turn/seq" },
    "payload": { "type": "object", "description": "type-specific fields; see examples/sample-episode.jsonl" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "message.sent" } } },
      "then": { "properties": { "payload": { "required": ["message_id", "from", "to", "body_ref"], "properties": {
        "message_id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string", "description": "recipient agent id; router may redirect or drop per topology" },
        "body_ref": { "type": "string", "description": "pointer into the run's message store, not the body itself" }
      } } } }
    },
    {
      "if": { "properties": { "type": { "const": "message.delivered" } } },
      "then": { "properties": { "payload": { "required": ["message_id", "to", "status"], "properties": {
        "message_id": { "type": "string" },
        "to": { "type": "string" },
        "status": { "enum": ["delivered", "undelivered"], "description": "undelivered must carry a reason (unreachable, filtered)" }
      } } } }
    },
    {
      "if": { "properties": { "type": { "const": "action.rejected" } } },
      "then": { "properties": { "payload": { "required": ["action_id", "reason"], "properties": {
        "action_id": { "type": "string" },
        "reason": { "type": "string" }
      } } } }
    },
    {
      "if": { "properties": { "type": { "const": "disturbance.applied" } } },
      "then": { "properties": { "payload": { "required": ["kind", "detail"], "properties": {
        "kind": { "enum": ["relay-loss", "stale-report", "peer-mute"] },
        "detail": { "type": "object", "description": "for relay-loss: {agent, until}; for stale-report: {message_id, claimed_state, actual_state}; for peer-mute: {agent}" }
      } } } }
    },
    {"if": {"properties": {"type": {"const": "policy.decision"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["policy", "freight_id", "path", "next_hop", "reason", "consumed_message_ids", "local_only_next_hop", "choice_changed", "decision_id", "observation_seq", "action_id", "opportunity"], "properties": {"policy": {"const": "route-gossip-v1"}, "freight_id": {"anyOf": [{"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, {"type": "null"}]}, "path": {"type": "array", "maxItems": 1025, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}}, "next_hop": {"anyOf": [{"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, {"type": "null"}]}, "reason": {"enum": ["route", "at_destination", "no_known_path", "no_visible_freight", "no_action_opportunity"]}, "consumed_message_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}}, "local_only_next_hop": {"anyOf": [{"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, {"type": "null"}]}, "choice_changed": {"type": "boolean"}, "decision_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "observation_seq": {"type": "integer", "minimum": 0}, "action_id": {"anyOf": [{"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, {"type": "null"}]}, "opportunity": {"type": "boolean"}}, "additionalProperties": false}}}},
    {"if": {"properties": {"type": {"const": "policy.report"}}}, "then": {"properties": {"payload": {"type": "object", "required": ["message_id", "sender", "admitted", "reason", "observed_turn", "routes"], "properties": {"message_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "sender": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "admitted": {"type": "boolean"}, "reason": {"type": ["string", "null"], "maxLength": 64}, "observed_turn": {"type": ["integer", "null"], "minimum": 1}, "routes": {"type": "object", "maxProperties": 32, "propertyNames": {"pattern": "^[a-zA-Z0-9_-]{1,64}->[a-zA-Z0-9_-]{1,64}$"}, "additionalProperties": {"enum": ["open", "closed"]}}}, "additionalProperties": false}}}},
    {"if": {"properties": {"type": {"const": "jobs.initialized"}}}, "then": {"properties": {"payload": {"type": "object", "properties": {"jobs": {"type": "array", "maxItems": 32, "items": {"type": "object", "properties": {"job_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "freight_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "state": {"const": "pending"}, "origin": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "destination": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "release_turn": {"const": 0}}, "required": ["job_id", "freight_id", "state", "origin", "destination", "release_turn"], "additionalProperties": false}}}, "required": ["jobs"], "additionalProperties": false}}}},
    {"if": {"properties": {"type": {"const": "job.completed"}}}, "then": {"properties": {"payload": {"type": "object", "properties": {"job_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "freight_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "action_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}}, "required": ["job_id", "freight_id", "action_id"], "additionalProperties": false}}}},
    {"if": {"properties": {"type": {"const": "run.end"}}}, "then": {"properties": {"payload": {"type": "object", "properties": {"jobs": {"type": "array", "maxItems": 32, "items": {"type": "object", "properties": {"job_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "freight_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"}, "state": {"enum": ["pending", "in-transit", "delivered", "stuck"]}}, "required": ["job_id", "freight_id", "state"], "additionalProperties": false}}, "termination": {"const": "completed"}, "horizon_turns": {"type": "integer", "minimum": 1, "maximum": 100}, "recovery_interval_turns": {"type": "integer", "minimum": 0}}, "required": ["jobs", "termination", "horizon_turns"], "additionalProperties": false}}}},
    {"if": {"properties": {"type": {"const": "run.config"}}}, "then": {"properties": {"payload": {"type": "object", "properties": {"job_evidence_version": {"type": "integer", "minimum": 1}, "horizon_turns": {"type": "integer", "minimum": 1, "maximum": 100}}, "required": ["job_evidence_version", "horizon_turns"]}}}}
  ]
}
