{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "swarmachines/events/v1",
  "title": "swarmachines event record",
  "description": "one record per logged event. (run_id, seq) is unique within a run and seq increases in append order; uniqueness is enforced by the runner, not by json schema. message lifecycle: sent, delivered, seen, acted_on are separate transitions and must never be conflated.",
  "type": "object",
  "required": [
    "run_id",
    "seq",
    "turn",
    "agent_id",
    "type",
    "ts",
    "payload"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "stable identifier for one episode"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "append-order index, unique with run_id"
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "null for world-level events"
    },
    "type": {
      "enum": [
        "run.config",
        "world.init",
        "turn.begin",
        "observation.recorded",
        "model.call",
        "model.call.failed",
        "message.sent",
        "message.delivered",
        "message.seen",
        "message.acted_on",
        "action.proposed",
        "action.validated",
        "action.rejected",
        "action.committed",
        "world.changed",
        "disturbance.applied",
        "model.decision",
        "run.end",
        "policy.decision",
        "policy.report",
        "jobs.initialized",
        "job.completed",
        "run.seal"
      ]
    },
    "chain": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 chain hash binding this record to its predecessor; present on every runner-appended record"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "description": "wall-clock at append time; logical time lives in turn/seq"
    },
    "payload": {
      "type": "object",
      "description": "type-specific fields; see examples/sample-episode.jsonl"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.sent"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "message_id",
              "from",
              "to",
              "body_ref"
            ],
            "properties": {
              "message_id": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string",
                "description": "recipient agent id; router may redirect or drop per topology"
              },
              "body_ref": {
                "type": "string",
                "description": "pointer into the run's message store, not the body itself"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.delivered"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "message_id",
              "to",
              "status"
            ],
            "properties": {
              "message_id": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "delivered",
                  "undelivered"
                ],
                "description": "undelivered must carry a reason (unreachable, filtered)"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "action.rejected"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "action_id",
              "reason"
            ],
            "properties": {
              "action_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "disturbance.applied"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "required": [
              "kind",
              "detail"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "relay-loss",
                  "stale-report",
                  "peer-mute"
                ]
              },
              "detail": {
                "type": "object",
                "description": "for relay-loss: {agent, until}; for stale-report: {message_id, claimed_state, actual_state}; for peer-mute: {agent}"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model.call"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "source_event_seq",
              "source_event_type",
              "call_id",
              "model",
              "prompt",
              "response",
              "tokens_in",
              "tokens_out",
              "receipt_ref",
              "provenance",
              "response_status",
              "response_id_sha256",
              "output_item_type_counts",
              "message_content_type_counts",
              "visible_response_chars",
              "total_tokens",
              "reasoning_tokens",
              "cached_input_tokens",
              "model_matches_selected",
              "latency_ms",
              "categorical_error"
            ],
            "properties": {
              "source_event_seq": {
                "type": "integer",
                "minimum": 0
              },
              "source_event_type": {
                "enum": [
                  "observation.recorded",
                  "policy.decision",
                  "disturbance.applied"
                ]
              },
              "call_id": {
                "type": "string",
                "pattern": "^call-[0-9]{4,}$"
              },
              "model": {
                "const": "glm-53-flash"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "response": {
                "type": "string",
                "minLength": 1
              },
              "tokens_in": {
                "type": "integer",
                "minimum": 0
              },
              "tokens_out": {
                "type": "integer",
                "minimum": 0
              },
              "receipt_ref": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "const": "model-generated"
              },
              "response_status": {
                "const": "completed"
              },
              "response_id_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_item_type_counts": {
                "type": "object",
                "maxProperties": 8,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "message_content_type_counts": {
                "type": "object",
                "maxProperties": 3,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "visible_response_chars": {
                "type": "integer",
                "minimum": 1
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "reasoning_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "model_matches_selected": {
                "const": true
              },
              "latency_ms": {
                "type": "number",
                "minimum": 0
              },
              "categorical_error": {
                "type": "null"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model.call.failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "source_event_seq",
              "source_event_type",
              "call_id",
              "model",
              "prompt",
              "tokens_in",
              "tokens_out",
              "receipt_ref",
              "provenance",
              "response_status",
              "incomplete_reason",
              "response_id_sha256",
              "output_item_type_counts",
              "message_content_type_counts",
              "visible_response_chars",
              "total_tokens",
              "reasoning_tokens",
              "cached_input_tokens",
              "model_matches_selected",
              "latency_ms",
              "categorical_error"
            ],
            "properties": {
              "source_event_seq": {
                "type": "integer",
                "minimum": 0
              },
              "source_event_type": {
                "enum": [
                  "observation.recorded",
                  "policy.decision"
                ]
              },
              "call_id": {
                "type": "string",
                "pattern": "^call-[0-9]{4,}$"
              },
              "model": {
                "const": "glm-53-flash"
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "tokens_in": {
                "type": "integer",
                "minimum": 0
              },
              "tokens_out": {
                "type": "integer",
                "minimum": 0
              },
              "receipt_ref": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "const": "model-generated"
              },
              "response_status": {
                "enum": [
                  "completed",
                  "incomplete",
                  "failed",
                  "cancelled",
                  "queued",
                  "in_progress",
                  "other"
                ]
              },
              "incomplete_reason": {
                "enum": [
                  "max_output_tokens",
                  "content_filter",
                  "other",
                  null
                ]
              },
              "response_id_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_item_type_counts": {
                "type": "object",
                "maxProperties": 8,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "message_content_type_counts": {
                "type": "object",
                "maxProperties": 3,
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "visible_response_chars": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "reasoning_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "cached_input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "model_matches_selected": {
                "type": "boolean"
              },
              "latency_ms": {
                "type": "number",
                "minimum": 0
              },
              "categorical_error": {
                "enum": [
                  "model_mismatch",
                  "response_not_completed",
                  "empty_visible_response",
                  "malformed_usage",
                  "malformed_output_text",
                  "provider_transport_error"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.decision"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "policy",
              "freight_id",
              "path",
              "next_hop",
              "reason",
              "consumed_message_ids",
              "local_only_next_hop",
              "choice_changed",
              "decision_id",
              "observation_seq",
              "action_id",
              "opportunity"
            ],
            "properties": {
              "policy": {
                "const": "route-gossip-v1"
              },
              "freight_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "path": {
                "type": "array",
                "maxItems": 1025,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                }
              },
              "next_hop": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "enum": [
                  "route",
                  "at_destination",
                  "no_known_path",
                  "no_visible_freight",
                  "no_action_opportunity"
                ]
              },
              "consumed_message_ids": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                }
              },
              "local_only_next_hop": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "choice_changed": {
                "type": "boolean"
              },
              "decision_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "observation_seq": {
                "type": "integer",
                "minimum": 0
              },
              "action_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "opportunity": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy.report"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "message_id",
              "sender",
              "admitted",
              "reason",
              "observed_turn",
              "routes"
            ],
            "properties": {
              "message_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "sender": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "admitted": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "observed_turn": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "routes": {
                "type": "object",
                "maxProperties": 32,
                "propertyNames": {
                  "pattern": "^[a-zA-Z0-9_-]{1,64}->[a-zA-Z0-9_-]{1,64}$"
                },
                "additionalProperties": {
                  "enum": [
                    "open",
                    "closed"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "jobs.initialized"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "jobs": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "freight_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "state": {
                      "const": "pending"
                    },
                    "origin": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "destination": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "release_turn": {
                      "const": 0
                    }
                  },
                  "required": [
                    "job_id",
                    "freight_id",
                    "state",
                    "origin",
                    "destination",
                    "release_turn"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "jobs"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "job.completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "freight_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "action_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              }
            },
            "required": [
              "job_id",
              "freight_id",
              "action_id"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.end"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "recovery_interval_turns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "jobs": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "properties": {
                    "job_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "freight_id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                    },
                    "state": {
                      "enum": [
                        "pending",
                        "in-transit",
                        "delivered",
                        "stuck"
                      ]
                    }
                  },
                  "required": [
                    "job_id",
                    "freight_id",
                    "state"
                  ],
                  "additionalProperties": false
                }
              },
              "termination": {
                "const": "completed"
              },
              "horizon_turns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "deliveries_completed": {
                "type": "integer",
                "minimum": 0,
                "description": "legacy run.end field preserved for backward compatibility"
              },
              "deliveries_stuck": {
                "type": "integer",
                "minimum": 0,
                "description": "legacy run.end field preserved for backward compatibility"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.config"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "seed": {
                "type": "integer",
                "minimum": 0
              },
              "comm_topology": {
                "type": "string"
              },
              "delivery_config_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "disturbance_schedule": {
                "type": "object"
              },
              "agents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                }
              },
              "policy": {
                "enum": [
                  "route-gossip-v1",
                  "model-route-v1"
                ]
              },
              "world": {
                "const": "freight"
              },
              "job_evidence_version": {
                "type": "integer",
                "minimum": 1
              },
              "horizon_turns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "model": {
                "enum": [
                  "deepseek-v4-flash",
                  "gemma-4-26b-a4b-it",
                  "gemma-4-31b-it",
                  "glm-5.2",
                  "glm-53-flash",
                  "qwen3.5-397b",
                  "qwen3.8-27b"
                ]
              },
              "world_regime": {
                "enum": [
                  "local-sufficient",
                  "peer-required"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.seal"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "chain",
              "events",
              "alg"
            ],
            "properties": {
              "chain": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "events": {
                "type": "integer",
                "minimum": 0
              },
              "alg": {
                "const": "eventlog-seal-v1"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "model.decision"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "policy",
              "decision_id",
              "observation_seq",
              "action_id",
              "status",
              "reason",
              "attempt_id",
              "model",
              "input_hash",
              "response_hash",
              "input_tokens",
              "output_tokens",
              "latency_ms",
              "reserved_microcredits",
              "charged_microcredits",
              "cost_basis",
              "available_message_ids"
            ],
            "properties": {
              "policy": {
                "const": "model-route-v1"
              },
              "decision_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,64}$"
              },
              "observation_seq": {
                "type": "integer",
                "minimum": 0
              },
              "action_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "completed",
                  "null",
                  "malformed",
                  "illegal",
                  "incomplete",
                  "input_rejected",
                  "evidence_failed",
                  "provider_failed",
                  "budget_stopped"
                ]
              },
              "reason": {
                "enum": [
                  "model_action",
                  "model_null",
                  "invalid_json",
                  "invalid_shape",
                  "invalid_reason",
                  "invalid_action_shape",
                  "action_not_candidate",
                  "max_output_tokens",
                  "provider_incomplete",
                  "input_limit",
                  "private_evidence_failed",
                  "provider_failed",
                  "budget_stopped"
                ]
              },
              "attempt_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "enum": [
                  "deepseek-v4-flash",
                  "gemma-4-26b-a4b-it",
